[Unit]
Description=VALD Django Web Application
After=network.target

[Service]
Type=notify
User=vald
Group=vald

WorkingDirectory=/home/vald/vald-www.git
# VALD_HOME comes from secrets.txt, not an Environment= line here: systemd
# applies these in file order, so a hardcoded value below would override the
# file and make the per-mirror setting silently ineffective.
EnvironmentFile=/home/vald/vald-www.git/secrets.txt
Environment="PATH=/home/vald/vald-www.git/.venv/bin:/usr/local/bin:/usr/bin:/bin"

# Gunicorn command.
# One process, many threads - deliberately, not for lack of cores. Job
# concurrency is governed by the in-process JobQueue (VALD_MAX_THREADS), which is
# only a real limit if there is a single process; with multiple gunicorn worker
# processes each got its own queue and the true ceiling was processes x
# VALD_MAX_THREADS. These are the two separate knobs. Threads are
# cheap here because request handlers just spawn a background thread and return,
# and the actual work is in subprocesses that release the GIL.
# --timeout bounds HTTP handling only (fast); extraction runs in a daemon thread
# off the request, so it is not killed by this timeout.
ExecStart=/home/vald/vald-www.git/.venv/bin/gunicorn \
    --bind unix:/run/vald/vald.socket \
    --workers 1 \
    --threads 8 \
    --worker-class gthread \
    --timeout 60 \
    --access-logfile - \
    --error-logfile - \
    vald_web.wsgi:application

# Restart policy
Restart=on-failure
RestartSec=5s

#Runtime directory - systemd creates /run/vald/ owned by User
RuntimeDirectory=vald
RuntimeDirectoryMode=0755

# Security hardening
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

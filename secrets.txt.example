# Per-site configuration for a VALD mirror.
#
# Copy to secrets.txt (which is gitignored) and edit. This is the only file
# that differs between VALD mirrors - the successor to the PHP interface's
# old/config/site_config_local.php. Everything here has a sensible Uppsala default
# in vald_web/settings_deploy.py except SECRET_KEY and VALD_HOME, so a minimal
# mirror file only needs those two plus the hostnames.
#
# Read by:
#   - systemd, via EnvironmentFile= in vald.service and vald-cleanup.service
#   - bin/vald-manage, which parses it the same way (as data, not shell)
#
# FORMAT: plain KEY=value, one per line, no export, no spaces around '='.
# Comments start with '#'. Values are read literally, so shell metacharacters
# in a value are fine - a Django SECRET_KEY with '(', '$', '!' works unquoted.
# Wrap a value that contains spaces in double quotes (both readers then strip
# one layer of surrounding quotes); other values need no quoting.
#
# chmod 600 secrets.txt - it holds the secret key.


# --- Required -------------------------------------------------------------

# Django secret key. Generate a fresh one per site, never reuse or commit it:
#   python -c 'import secrets; print(secrets.token_urlsafe(64))'
SECRET_KEY=CHANGE-ME

# Root of the VALD data installation: contains bin/, CONFIG/, MODELS/,
# WWW/public_html/FTP/. No trailing slash.
VALD_HOME=/home/vald/VALD3


# --- Site identity --------------------------------------------------------

# Shown in page headers and email signatures
VALD_SITENAME="VALD Uppsala"

# Hostnames this instance answers on, comma separated
VALD_ALLOWED_HOSTS=vald.astro.uu.se,localhost,127.0.0.1

# Scheme + host with no path, used to build links in emails
VALD_SITE_URL=https://vald.astro.uu.se

# Origins allowed to POST, comma separated. Scheme is required.
VALD_CSRF_TRUSTED_ORIGINS=https://vald.astro.uu.se

# Sub-path the app is served under, no trailing slash. Leave empty to serve
# from the site root. The cookie paths and STATIC_URL derive from this, so it
# is the only place the prefix is configured.
#
# NB changing this signs out every logged-in user, because the session and
# CSRF cookie paths change with it. Set it empty when the new interface takes
# over the site root from the legacy one.
VALD_URL_PREFIX=/new


# --- Addresses ------------------------------------------------------------

# Envelope sender for outgoing mail
VALD_FROM_EMAIL=vald@physics.uu.se

# Contact form recipients, and where django.request errors are mailed
VALD_ADMIN_EMAIL=someone@example.edu
VALD_WEBMASTER_EMAIL=someone@example.edu


# --- Optional -------------------------------------------------------------

# Never enable on a public site: DEBUG leaks settings and tracebacks
#DEBUG=False

